# Copiá este archivo a .env y completá tus keys. NUNCA subas el .env real al repositorio.

# --- Pinecone ---
PINECONE_API_KEY=pcsk_...
INDEX_NAME=rag-escalable
# PINECONE_NAMESPACE=docs-python-stdlib
# PINECONE_CLOUD=aws          # el plan gratuito solo admite aws / us-east-1
# PINECONE_REGION=us-east-1

# --- Embeddings (dimensión 1536) ---
EMBEDDINGS_PROVIDER=gemini    # gemini | openai
GEMINI_API_KEY=...            # API key de Google AI Studio
OPENAI_API_KEY=sk-...         # solo si EMBEDDINGS_PROVIDER=openai
