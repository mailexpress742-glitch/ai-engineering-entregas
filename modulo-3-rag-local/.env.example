# Copiá este archivo a .env y completá tus keys. NUNCA subas el .env real al repositorio.

# Embeddings (siempre Gemini, tanto para indexar como para consultar)
GEMINI_API_KEY=...   # API key de Google AI Studio

# LLM que genera la respuesta: anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Opcional: fuerza un modelo del LLM
# LLM_MODEL=
