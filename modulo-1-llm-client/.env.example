# Copiá este archivo a .env y completá la key del proveedor que vayas a usar.
# NUNCA subas el .env real al repositorio.

# Proveedor activo: openai | anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales (valores por defecto entre paréntesis)
# LLM_MODEL=            # (gpt-4o-mini para openai, claude-haiku-4-5 para anthropic)
# LLM_TEMPERATURE=0.7   # 0 a 2 (Anthropic admite hasta 1; se recorta solo)
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=60        # segundos por llamada
# LLM_MAX_RETRIES=3     # reintentos ante rate limit / red / timeout
