# Copiá este archivo a .env y completá la key del proveedor. NUNCA subas el .env real al repositorio.

# LLM del agente: anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...   # API key de Google AI Studio

# Opcional
# LLM_MODEL=
# CHECKPOINT_DB=agente_memoria.sqlite   # archivo SQLite de la memoria
# RECURSION_LIMIT=10
