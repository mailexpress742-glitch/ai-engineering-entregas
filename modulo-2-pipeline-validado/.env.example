# Copiá este archivo a .env y completá la key del proveedor que vayas a usar.
# NUNCA subas el .env real al repositorio.

# Proveedor activo: anthropic | openai | gemini
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...   # API key de Google AI Studio

# Opcional: fuerza un modelo (por defecto claude-haiku-4-5 / gpt-4o-mini / gemini-3.5-flash-lite)
# LLM_MODEL=
