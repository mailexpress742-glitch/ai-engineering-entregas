# Copiá este archivo a .env y completá las keys. NUNCA subas el .env real al repositorio.

# --- LLM de los agentes: anthropic | openai  (Gemini 3 no es compatible: exige thought_signature) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# LLM_MODEL=claude-haiku-4-5

# --- RAG híbrido: Pinecone (vectorial) + BM25 (léxico) ---
# RAG_BACKEND=pinecone  → híbrido (por defecto). RAG_BACKEND=local → solo BM25, sin cuenta ni red.
RAG_BACKEND=pinecone
PINECONE_API_KEY=pcsk_...
INDEX_NAME=rag-escalable
PINECONE_NAMESPACE=reclamos-mailex
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# Embeddings (1536 dim): gemini (gemini-embedding-001, plan gratuito) u openai (text-embedding-3-small)
EMBEDDINGS_PROVIDER=gemini
GEMINI_API_KEY=...

# --- Redis: estado de los reclamos, cola de trabajo y checkpoints de LangGraph ---
REDIS_URL=redis://localhost:6379/0

# --- Workers asyncio dentro del proceso de la API (0 = solo API; corré `python -m app.worker` aparte) ---
WORKERS=5
JOB_TIMEOUT_S=300

# --- Observabilidad con Arize Phoenix (dejá vacío para desactivar el envío de trazas) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=mesa-reclamos

# Alternativa LangSmith (en vez de Phoenix): descomentá y completá
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=mesa-reclamos

# --- Datos de demostración ---
# "Hoy" fijo para que el seguimiento sintético y las demos sean reproducibles (vacío = fecha real)
HOY_SIMULADO=2026-11-18
