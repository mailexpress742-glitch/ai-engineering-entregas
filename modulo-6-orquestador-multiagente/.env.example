# Copiá este archivo a .env y completá la key del proveedor. NUNCA subas el .env real al repositorio.

# LLM de los agentes: anthropic | openai  (Gemini 3 no es compatible: exige thought_signature en las llamadas a herramientas)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Opcional
# LLM_MODEL=
